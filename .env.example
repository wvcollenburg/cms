# Copy to .env and adjust. On STRATO this lives in ~/private/.env
SECRET_KEY=change-me
BASE_URL=http://localhost:5000
# SQLite for local dev tonight; MariaDB on the VM / STRATO:
# DATABASE_URL=mysql+pymysql://createur:secret@localhost/createur?charset=utf8mb4
DATABASE_URL=sqlite:///dev.db
MEDIA_ROOT=instance/media
PRIVATE_ROOT=instance/private
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Broedplaats de Createur <noreply@example.org>
# Demo only; the app refuses to start with DEMO_MODE=1 unless BASE_URL's host is in DEMO_HOSTS
DEMO_MODE=1
DEMO_HOSTS=localhost,127.0.0.1
DEMO_PASSWORD=createur-demo
# Daily tasks (PLAN D17/D21). Without TASK_SECRET the task API is off; the fallback during
# normal visits still runs them. Make one with: python3 -c "import secrets; print(secrets.token_hex(32))"
TASK_SECRET=
# Healthchecks.io check URL: pinged after every run, so a run that doesn't happen raises an alert
HEALTHCHECK_URL=
# Demo only: reset the demo content in the nightly run (off until the demo content is final)
DEMO_NIGHTLY_RESET=0
