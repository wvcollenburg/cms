# Production settings on STRATO. Copy to ~/private/.env on the server (chmod 600) and fill in.
# Paths may start with ~/ (your STRATO home).

# Make one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
BASE_URL=https://<domain>

# STRATO control panel → Databases. Host, user and database name are shown there.
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>/<database>?charset=utf8mb4

MEDIA_ROOT=~/<domain>/media
PAGE_CACHE_ROOT=~/<domain>/_cache
PRIVATE_ROOT=~/private

# The STRATO mailbox that sends the login links (smtp.strato.de, port 587 with STARTTLS)
MAIL_SERVER=smtp.strato.de
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=noreply@<domain>
MAIL_PASSWORD=
MAIL_FROM=Broedplaats de Createur <noreply@<domain>>

# Never on in production (the app refuses to start if it is)
DEMO_MODE=0
DEMO_NIGHTLY_RESET=0

# Daily tasks: the same secret goes into the cron job on William's server (deploy/call-tasks.sh)
TASK_SECRET=
# Healthchecks.io → the check's ping URL, e.g. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=
